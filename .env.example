# ─────────────────────────────────────────────────────────────────────────────
# ENTROPY — Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your deployment environment.
# Never commit actual production secrets to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
SITE_BASE_URL=https://entropy.design

# Reverse Proxy Security
# Set to 'true' if running behind Nginx, Cloudflare, AWS ALB, etc. to trust X-Forwarded-For
TRUST_PROXY=false

# Optional Fallback Admin Account Setup
ADMIN_EMAIL=admin@entropy.design
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!

# Outbound Email Notification Configuration (SMTP / Transactional Provider)
# Leave SMTP_HOST blank in local development to automatically use the safe diagnostic mock transport.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here

# Email Sender & Routing Addresses
EMAIL_FROM="ENTROPY" <hello@entropy.design>
EMAIL_REPLY_TO=entropy.helpdesk@gmail.com
STUDIO_NOTIFICATION_EMAIL=entropy.helpdesk@gmail.com

# AI Studio / Applet Integration (Optional)
GEMINI_API_KEY=
APP_URL=
